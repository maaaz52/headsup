{
  "name": "headsup",
  "version": "1.0.2",
  "description": "Headsup - a friendly character flies across your screen before each meeting",
  "main": "out/main/index.js",
  "author": "maaz",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run dist:win",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac --x64 --arm64",
    "dist:linux": "npm run build && electron-builder --linux --x64"
  },
  "build": {
    "appId": "com.headsup.app",
    "productName": "Headsup",
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${os}-${arch}.${ext}",
    "files": [
      "out/**/*",
      "build/icon.png",
      "node_modules/node-ical/**/*",
      "node_modules/ical.js/**/*",
      "node_modules/rrule/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "maintainer": "maaz"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Headsup"
    }
  },
  "dependencies": {
    "node-ical": "^0.27.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "^5.6.0",
    "vite": "7.3.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
